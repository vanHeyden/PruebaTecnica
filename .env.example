PORT=3000

# Ambiente UAT de Kushki México
# Documentación: https://docs.kushki.com/mx
# API: https://api-docs.kushkipagos.com/mexico/home
KUSHKI_API_BASE_URL=https://api-uat.kushkipagos.com

# ID de la Kajita creada en consola UAT
KUSHKI_KFORM_ID=NjdqaKBZC

# ID de comercio (referencia). La credencial pública se envía en publicMerchantId.
KUSHKI_MERCHANT_ID=20000000105136820000

# Credencial pública (Public-Merchant-Id / publicMerchantId del script Kajita)
KUSHKI_PUBLIC_KEY=

# Credencial privada. Nunca se expone al navegador.
KUSHKI_PRIVATE_KEY=

# Monto de prueba alineado al script de la Kajita
AMOUNT_SUBTOTAL_IVA=0
AMOUNT_IVA=0
AMOUNT_SUBTOTAL_IVA0=1000
KUSHKI_CURRENCY=MXN
